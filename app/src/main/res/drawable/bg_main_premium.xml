<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Soft Lavender Glow Background (Light Mode default, night override in drawable-night/) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid Base Light Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
        </shape>
    </item>

    <!-- Glowing Spot 1 (Top-Right): Soft Rose/Pink -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="0.85"
                android:centerY="0.1"
                android:startColor="#18E879F9"
                android:endColor="#00F5F3FA" />
        </shape>
    </item>

    <!-- Glowing Spot 2 (Middle-Left): Soft Lavender -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="550dp"
                android:centerX="0.15"
                android:centerY="0.45"
                android:startColor="#1AC7D2FE"
                android:endColor="#00F5F3FA" />
        </shape>
    </item>

    <!-- Glowing Spot 3 (Bottom-Right): Soft Cyan -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="650dp"
                android:centerX="0.8"
                android:centerY="0.8"
                android:startColor="#1480DEEA"
                android:endColor="#00F5F3FA" />
        </shape>
    </item>

</layer-list>
