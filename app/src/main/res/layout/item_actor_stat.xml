<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp"
    android:gravity="center_vertical"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/tvRank"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#A5B4FC"
        android:background="@drawable/bg_quick_action_glass"
        tools:text="1" />

    <!-- Actor Photo with subtle border -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/outline_variant"
        app:cardBackgroundColor="@color/poster_placeholder_dark">

        <ImageView
            android:id="@+id/ivActorPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            tools:src="@tools:sample/avatars" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Actor Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvActorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_semibold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Леонардо Ді Капріо" />

        <TextView
            android:id="@+id/tvMoviesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:layout_marginTop="2dp"
            tools:text="6 фільмів • 14 год" />

        <TextView
            android:id="@+id/tvMovieTitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            tools:text="Inception, Shutter Island, Titanic..." />

    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_hint"
        android:contentDescription="@null" />

</LinearLayout>
