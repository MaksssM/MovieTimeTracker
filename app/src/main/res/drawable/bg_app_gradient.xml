<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Clean dark base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#0D0D14"
                android:centerColor="#0F0F19"
                android:endColor="#0C0C14"
                android:angle="160" />
        </shape>
    </item>
    
    <!-- Soft teal glow overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="85%"
                android:centerY="15%"
                android:startColor="#1A00E5CC"
                android:endColor="#00000000" />
        </shape>
    </item>
    
    <!-- Secondary purple accent glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="15%"
                android:centerY="85%"
                android:startColor="#1F7B2FFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    
</layer-list>
