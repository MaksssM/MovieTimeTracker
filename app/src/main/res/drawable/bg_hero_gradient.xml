<?xml version="1.0" encoding="utf-8"?>
<!-- Hero spotlight: brand gradient, identical in both themes (vibrant on light and dark) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#7C5CE7"
                android:centerColor="#6A5AE0"
                android:endColor="#00B8D4" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Soft top highlight -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="23dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
