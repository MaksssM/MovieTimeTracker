<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#141622"
    app:cardBackgroundColor="#08090D"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/card_press_bounce">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Purple Left Accent Line -->
        <View
            android:id="@+id/viewAccentBar"
            android:layout_width="3.5dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_accent_bar_planned" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp">

            <!-- Poster with rounded corners -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/posterCard"
                android:layout_width="86dp"
                android:layout_height="128dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1A1D2B"
                app:cardBackgroundColor="#0F111A"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/poster_description"
                        android:transitionName="poster_transition"
                        tools:src="@tools:sample/backgrounds/scenic" />

                    <!-- Bottom gradient overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/gradient_overlay_dark" />

                    <!-- Media Type Badge -->
                    <TextView
                        android:id="@+id/tvMediaType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_type_badge_planned"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textSize="9sp"
                        android:textColor="#C084FC"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        tools:text="TV" />

                    <!-- Rating badge at top-right -->
                    <LinearLayout
                        android:id="@+id/layoutRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_rating_badge_gold"
                        android:orientation="horizontal"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="2dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_star_filled_24"
                            app:tint="#FBBF24"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:textSize="10sp"
                            android:textColor="#FBBF24"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            tools:text="8.5" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Content Details Container -->
            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="@id/posterCard"
                app:layout_constraintEnd_toStartOf="@+id/actionsContainer"
                app:layout_constraintStart_toEndOf="@id/posterCard"
                app:layout_constraintTop_toTopOf="@id/posterCard"
                app:layout_constraintVertical_bias="0.5">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    tools:text="Інтерстеллар" />

                <!-- Release Year Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#A855F7"
                        android:contentDescription="@string/release_date" />

                    <TextView
                        android:id="@+id/tvReleaseDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        android:fontFamily="sans-serif"
                        tools:text="2024" />

                </LinearLayout>

                <!-- Runtime Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quick_action_glass"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_time"
                        app:tint="#C084FC"
                        android:contentDescription="@string/runtime" />

                    <TextView
                        android:id="@+id/tvRuntime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="11sp"
                        android:textColor="#C084FC"
                        android:fontFamily="sans-serif-medium"
                        tools:text="2 год 49 хв" />

                </LinearLayout>

                <!-- Added Date Badge -->
                <LinearLayout
                    android:id="@+id/layoutAddedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quick_action_glass"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_bookmark_24"
                        app:tint="#A855F7"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvAddedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="11sp"
                        android:textColor="#A855F7"
                        android:fontFamily="sans-serif-medium"
                        tools:text="15 січ" />

                </LinearLayout>

            </LinearLayout>

            <!-- Action Buttons Column -->
            <LinearLayout
                android:id="@+id/actionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Move to Watching Button -->
                <ImageButton
                    android:id="@+id/btnMoveToWatching"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_action_rewatch"
                    android:src="@drawable/ic_play_circle_24"
                    android:padding="8dp"
                    app:tint="#10B981"
                    android:contentDescription="@string/move_to_watching"
                    android:layout_marginBottom="8dp" />

                <!-- Delete Button -->
                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_action_delete"
                    android:src="@drawable/ic_delete_forever_24"
                    android:padding="8dp"
                    app:tint="#F87171"
                    android:contentDescription="@string/delete" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
