<?xml version="1.0" encoding="utf-8"?>
<!-- Light variant of bg_chip — already uses light gradients -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Subtle shadow -->
    <item android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Main chip background (light) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FAFBFF"
                android:endColor="#EEF2FF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#CAC4D0" />
        </shape>
    </item>

</layer-list>
